---
import { useTranslations } from "../utils/i18n";

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang as any);
const langPrefix = lang === 'en' ? '' : `/${lang}`;

const services = [
  {
    id: "produksi-furniture",
    title: t('service.furniture'),
    image: "/images/Foto mesin.png",
    isVideo: false,
    href: `${langPrefix}/layanan/produksi-furniture`,
  },
  {
    id: "desain-interior",
    title: t('service.interior'),
    image: "/images/project/PRODUKSI/3.png",
    isVideo: false,
    href: `${langPrefix}/layanan/desain-interior`,
  },
  {
    id: "wall-panel-decoration",
    title: t('service.wallpanel'),
    image: "/images/project/PRODUKSI/4.png",
    isVideo: false,
    href: `${langPrefix}/layanan/wall-panel-decoration`,
  },
];
---

<section id="our-service" class="os-section">
  <div class="os-grid">
    <!-- Top Row: 2 cards side by side -->
    <div class="os-top-row">
      {services.slice(0, 2).map((service) => (
        <a href={service.href} class="os-card" id={`service-card-${service.id}`}>
          <!-- Background Media -->
          {service.isVideo ? (
            <video
              class="os-card-media"
              autoplay
              muted
              loop
              playsinline
              aria-hidden="true"
            >
              <source src={service.image} type="video/mp4" />
            </video>
          ) : (
            <img
              class="os-card-media"
              src={service.image}
              alt={service.title}
              loading="lazy"
            />
          )}

          <!-- Gradient Overlay -->
          <div class="os-card-overlay"></div>

          <!-- Service Title -->
          <h3 class="os-card-title">{service.title}</h3>

          <!-- Arrow Button -->
          <div class="os-arrow-btn" aria-label={`${t('service.view')} ${service.title}`}>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="os-arrow-icon"
            >
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom Row: 1 card + "Our Service" text -->
    <div class="os-bottom-row">
      <!-- Third Card -->
      <a href={services[2].href} class="os-card os-card-bottom" id={`service-card-${services[2].id}`}>
        <img
          class="os-card-media"
          src={services[2].image}
          alt={services[2].title}
          loading="lazy"
        />
        <div class="os-card-overlay"></div>
        <h3 class="os-card-title">{services[2].title}</h3>
        <div class="os-arrow-btn" aria-label={`${t('service.view')} ${services[2].title}`}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="os-arrow-icon"
          >
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </div>
      </a>

      <!-- "Our Service" Title Block -->
      <div class="os-title-block">
        <div class="os-title-lines" aria-hidden="true">
          {Array.from({ length: 8 }).map((_, i) => (
            <div class="os-line" style={`transform: rotate(-45deg) translateX(${i * 6}px);`}></div>
          ))}
        </div>
        <h2 class="os-main-title" set:html={t('service.title')} />
      </div>
    </div>
  </div>
</section>

<style>
  /* ─── Section ─── */
  .os-section {
    background-color: #ffffff;
    padding: 48px 32px 64px;
    font-family: 'Plus Jakarta Sans', serif;
    border-top: 1px solid rgba(19, 32, 69, 0.07);
  }

  /* ---- Grid Wrapper ---- */
  .os-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* ---- Top Row ---- */
  .os-top-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  /* ---- Bottom Row ---- */
  .os-bottom-row {
    display: grid;
    grid-template-columns: 3fr 1fr;
    gap: 8px;
    align-items: stretch;
  }

  /* ---- Card Base ---- */
  .os-card {
    position: relative;
    display: block;
    overflow: hidden;
    text-decoration: none;
    border-radius: 2px;
    cursor: pointer;
    height: 300px;
  }

  .os-card-bottom {
    height: 340px;
  }

  /* ---- Media (img/video) ---- */
  .os-card-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .os-card:hover .os-card-media {
    transform: scale(1.06);
  }

  /* ---- Dark gradient overlay ---- */
  .os-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(5, 15, 40, 0.45) 0%,
      rgba(5, 15, 40, 0.15) 50%,
      rgba(5, 15, 40, 0.05) 100%
    );
    transition: background 0.4s ease;
    z-index: 1;
  }

  .os-card:hover .os-card-overlay {
    background: linear-gradient(
      135deg,
      rgba(5, 15, 40, 0.55) 0%,
      rgba(5, 15, 40, 0.25) 50%,
      rgba(5, 15, 40, 0.1) 100%
    );
  }

  /* ---- Service Title ---- */
  .os-card-title {
    position: absolute;
    top: 20px;
    left: 24px;
    right: 80px;
    z-index: 2;
    font-family: 'Plus Jakarta Sans', serif;
    font-size: 1.35rem;
    font-weight: 500;
    color: #ffffff;
    line-height: 1.3;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
    letter-spacing: 0.01em;
    margin: 0;
    transition: transform 0.4s ease;
  }

  .os-card:hover .os-card-title {
    transform: translateY(-2px);
  }

  /* ---- Arrow Button ---- */
  .os-arrow-btn {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background-color: #132045;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: background-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 18px rgba(13, 27, 62, 0.4);
  }

  .os-card:hover .os-arrow-btn {
    background-color: #e4222e;
    transform: translateX(-50%) scale(1.1);
    box-shadow: 0 6px 24px rgba(228, 34, 46, 0.45);
  }

  .os-arrow-icon {
    width: 22px;
    height: 22px;
    transition: transform 0.3s ease;
  }

  .os-card:hover .os-arrow-icon {
    transform: translateX(3px);
  }

  /* ---- "Our Service" Title Block ---- */
  .os-title-block {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 24px 16px 28px;
    overflow: hidden;
    background-color: #ffffff;
  }

  .os-main-title {
    font-family: 'Plus Jakarta Sans', serif;
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    font-weight: 800;
    color: #132045;
    line-height: 1.05;
    text-align: right;
    margin: 0;
    z-index: 1;
    position: relative;
    letter-spacing: -0.01em;
  }

  /* ---- Diagonal lines decoration ---- */
  .os-title-lines {
    position: absolute;
    bottom: 28px;
    right: 0;
    width: 100%;
    display: flex;
    gap: 0;
    overflow: visible;
    z-index: 0;
    pointer-events: none;
  }

  .os-line {
    position: absolute;
    bottom: -60px;
    right: 0;
    width: 120%;
    height: 2.5px;
    background-color: #132045;
    opacity: 0.18;
  }

  /* Override individual lines to stack diagonally */
  .os-title-lines {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 40px;
    overflow: hidden;
  }

  /* Recreate the diagonal lines pattern matching the image */
  .os-line {
    position: absolute;
    left: -20%;
    width: 140%;
    height: 2px;
    background: #132045;
    opacity: 0.2;
    border-radius: 1px;
    transform-origin: left center;
  }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .os-section {
      padding: 32px 16px 48px;
    }

    .os-top-row {
      grid-template-columns: 1fr;
    }

    .os-bottom-row {
      grid-template-columns: 1fr;
    }

    .os-card {
      height: 260px;
    }

    .os-card-bottom {
      height: 260px;
    }

    .os-title-block {
      height: 120px;
      align-items: center;
      justify-content: center;
    }

    .os-main-title {
      text-align: center;
      font-size: 2.5rem;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .os-card {
      height: 260px;
    }

    .os-card-bottom {
      height: 290px;
    }
  }
</style>

<script>
  const initOurService = () => {
    // Animate cards on scroll with stagger
    const cards = document.querySelectorAll('.os-card, .os-title-block');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          // slight stagger
          setTimeout(() => {
            (entry.target as HTMLElement).style.opacity = '1';
            (entry.target as HTMLElement).style.transform = 'translateY(0)';
          }, i * 80);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    cards.forEach((card) => {
      (card as HTMLElement).style.opacity = '0';
      (card as HTMLElement).style.transform = 'translateY(24px)';
      (card as HTMLElement).style.transition = 'opacity 0.7s cubic-bezier(0.22,1,0.36,1), transform 0.7s cubic-bezier(0.22,1,0.36,1)';
      observer.observe(card);
    });
  };

  document.addEventListener('DOMContentLoaded', initOurService);
  document.addEventListener('astro:page-load', initOurService);
</script>
