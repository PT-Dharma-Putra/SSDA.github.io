---
import { useTranslations } from "../utils/i18n";

const lang = Astro.currentLocale || "en";
const t = useTranslations(lang as any);
---

<section
  id="home"
  class="relative min-h-screen flex items-center overflow-hidden px-6 lg:px-20"
>
  <!-- Background Layer -->
  <div class="absolute inset-0 z-0">
    <!-- Video with subtle scale for movement -->
    <video
      autoplay
      loop
      muted
      playsinline
      class="w-full h-full object-cover scale-[1.02] opacity-90"
    >
      <source src="/images/video/Untitled design (5).mp4" type="video/mp4" />
    </video>

    <!-- Sophisticated Overlay Gradients -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-navy/80 via-navy/40 to-transparent"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-navy/60 via-transparent to-navy/30"
    >
    </div>

    <!-- Grain Texture for a natural feel -->
    <div
      class="absolute inset-0 opacity-[0.03] pointer-events-none mix-blend-overlay bg-[url('https://grainy-gradients.vercel.app/noise.svg')]"
    >
    </div>
  </div>

  <div
    class="relative z-10 w-full max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center pt-12 md:pt-16"
  >
    <!-- Left Content (Text) -->
    <div class="lg:col-span-7 text-left space-y-6 animate-hero-reveal">
      <div class="inline-flex items-center gap-4">
        <span class="w-12 h-px bg-primary/60"></span>
        <span
          class="text-white/60 text-[10px] md:text-xs font-bold uppercase tracking-[0.4em]"
        >
          {
            lang === "en"
              ? "Exquisite Interior Design"
              : "Desain Interior Eksklusif"
          }
        </span>
      </div>

      <h1
        class="font-display text-4xl md:text-5xl lg:text-[3.8rem] text-white font-bold tracking-tight leading-[1.1] drop-shadow-2xl"
        set:html={t("hero.title")}
      />

      <p
        class="text-white/70 text-base md:text-lg font-light leading-relaxed max-w-xl"
      >
        {
          lang === "en"
            ? "Crafting bespoke living environments that harmonize modern innovation with timeless natural beauty."
            : "Menciptakan lingkungan hidup khusus yang mengharmonisasikan inovasi modern dengan keindahan alam abadi."
        }
      </p>

      <div class="flex flex-wrap gap-6 pt-2">
        <a
          href="#our-service"
          class="group relative inline-flex items-center gap-3 px-8 py-4 bg-primary text-white rounded-2xl overflow-hidden shadow-xl shadow-primary/20 transition-all duration-300 hover:-translate-y-1"
        >
          <span
            class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-500"
          ></span>
          <span
            class="relative z-10 font-bold text-xs uppercase tracking-widest"
            >{t("nav.services")}</span
          >
          <span
            class="material-icons-outlined relative z-10 text-xl group-hover:translate-x-1 transition-transform"
            >arrow_forward</span
          >
        </a>
      </div>
    </div>

    <!-- Right Content (Asymmetric Image Layout) -->
    <!-- Right Content (Minimalist Asymmetric Image Layout) -->
    <div class="lg:col-span-5 relative hidden md:block">
      <div class="relative w-full aspect-square animate-hero-reveal delay-300">
        <!-- Main Image (Smaller & More Refined) -->
        <div
          class="absolute top-0 right-0 w-[65%] aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl border border-white/10 group z-10 hover:z-30 transition-all duration-500"
        >
          <img
            src="/images/1.png"
            alt="Interior View 1"
            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-navy/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>
        </div>

        <!-- Floating Secondary Image (Smaller & More Offset) -->
        <div
          class="absolute bottom-10 left-4 w-[50%] aspect-square rounded-3xl overflow-hidden shadow-2xl border border-white/20 group z-20 hover:z-30 transition-all duration-500"
        >
          <img
            src="/images/LUMINOR 3.webp"
            alt="Interior View 2"
            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
          />
          <div
            class="absolute inset-0 bg-gradient-to-t from-navy/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>
        </div>

        <!-- Decorative Accents (Minimalist) -->
        <div
          class="absolute top-10 -right-4 w-24 h-24 border-t border-r border-primary/30 rounded-tr-3xl -z-10"
        >
        </div>
        <div
          class="absolute -bottom-8 left-0 w-40 h-40 bg-primary/5 rounded-full blur-3xl -z-10 animate-pulse"
        >
        </div>
      </div>
    </div>
  </div>

  <!-- Refined Scroll Indicator -->
  <div
    class="absolute bottom-12 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-4 opacity-40 hover:opacity-100 transition-opacity duration-500"
  >
    <span
      class="text-[10px] font-bold uppercase tracking-[0.3em] text-white rotate-90 mb-8 origin-center"
      >{lang === "en" ? "SCROLL" : "GULIR"}</span
    >
    <div
      class="w-px h-16 bg-gradient-to-b from-white to-transparent relative overflow-hidden"
    >
      <div
        class="absolute top-0 left-0 w-full h-1/3 bg-primary animate-scroll-line"
      >
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes hero-reveal {
    0% {
      opacity: 0;
      transform: translateY(40px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes scroll-line {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(300%);
    }
  }

  .animate-hero-reveal {
    animation: hero-reveal 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    opacity: 0;
  }

  .animate-scroll-line {
    animation: scroll-line 2s infinite cubic-bezier(0.4, 0, 0.2, 1);
  }

  .delay-300 {
    animation-delay: 300ms;
  }
</style>
