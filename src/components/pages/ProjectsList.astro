---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import fs from "node:fs";
import path from "node:path";
import { projectsData } from "../../data/projects.js";
import { useTranslations } from "../../utils/i18n";

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang as any);
const langPrefix = lang === 'en' ? '' : `/${lang}`;

const projects = projectsData.map((project) => {
  if (project.image && fs.existsSync(path.join(process.cwd(), "public", project.image.replace(/^\//, '')))) {
    return project;
  }
  if (project.folderName) {
    try {
      const folderPath = path.join(
        process.cwd(),
        "public",
        "images",
        "project",
        project.folderName,
      );
      if (fs.existsSync(folderPath)) {
        const files = fs.readdirSync(folderPath);
        const images = files.filter((f) =>
          [".jpg", ".jpeg", ".png", ".webp"].includes(
            path.extname(f).toLowerCase(),
          ),
        );
        if (images.length > 0) {
          return {
            ...project,
            image: `/images/project/${project.folderName}/${images[0]}`,
          };
        }
      }
    } catch (e) {}
  }
  return project;
});
---

<Layout title={`${t('nav.projects')} | PT Swastika Suraga Dharma`}>
  <Navbar />

  <main class="pt-20 pb-8">
    <div class="max-w-7xl mx-auto px-6">
      <header class="mb-8 border-b border-primary/10 pb-12">
        <span
          class="text-primary font-bold tracking-[0.2em] uppercase text-sm mb-2 block"
          >{t('projects.portfolio')}</span
        >
        <h1
          class="font-display text-5xl md:text-6xl text-[#132045] font-bold mb-6 italic uppercase"
        >
          {t('nav.projects')}
        </h1>
        <p class="text-slate-500 max-w-2xl text-lg">
          {t('projects.subtitle')}
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          projects.map((project) => (
            <a
              href={`${langPrefix}/projects/${project.slug}`}
              class="group cursor-pointer flex flex-col bg-white rounded-2xl p-4 border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-500"
            >
              <div class="rounded-xl overflow-hidden mb-4 relative aspect-[4/3] bg-slate-100">
                <img
                  alt={project.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  src={project.image}
                  onerror="this.src='https://placehold.co/800x600?text=Project+Image'"
                />
                
                <!-- Category badge -->
                <div class="absolute top-3 left-3 z-20">
                  <span class="inline-block px-3 py-1 bg-white/90 backdrop-blur-md text-[#132045] font-bold text-[11px] tracking-wider uppercase rounded-full shadow-sm">
                    {project.category[lang as keyof typeof project.category] || project.category.en}
                  </span>
                </div>

                <!-- Specific badge (e.g. BPJS / Non BPJS) -->
                {project.badge && (
                  <div class="absolute top-3 right-3 z-20">
                    <span class="inline-block px-3 py-1 bg-[#132045]/90 backdrop-blur-md border border-white/20 text-white font-bold text-[11px] tracking-wider uppercase rounded-full shadow-sm">
                      {project.badge}
                    </span>
                  </div>
                )}
              </div>

              <!-- Text Content cleanly below image -->
              <div class="px-1 flex-grow flex flex-col justify-between">
                <div>
                  <h3 class="font-display text-xl font-bold text-[#132045] group-hover:text-primary transition-colors mb-2 flex items-center justify-between gap-2">
                    <span>{project.title}</span>
                    {project.badge && (
                      <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-[#132045] border border-slate-200 uppercase tracking-wider shrink-0">
                        {project.badge}
                      </span>
                    )}
                  </h3>
                  <p class="text-sm text-slate-500 line-clamp-3 leading-relaxed">
                    {project.description[lang as keyof typeof project.description] || project.description.en}
                  </p>
                </div>

                <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-primary tracking-wider uppercase">
                  <span>{t('projects.viewDetail')}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </main>
</Layout>

<script>
  import {
    getWatermarkedDataUrl,
    preloadWatermark,
  } from "../../utils/watermark.js";

  function initGhostWatermark() {
    const images = document.querySelectorAll("main img");

    images.forEach((img) => {
      if (!(img instanceof HTMLImageElement)) return;

      const originalSrc = img.src;
      let isWatermarked = false;

      // Preload saat halaman dimuat
      if (originalSrc && !originalSrc.startsWith("data:")) {
        preloadWatermark(originalSrc);
      }

      img.addEventListener("contextmenu", async (e) => {
        if (isWatermarked || img.src.startsWith("data:")) return;

        try {
          const watermarkedSrc = await getWatermarkedDataUrl(originalSrc);
          img.src = watermarkedSrc;
          isWatermarked = true;

          setTimeout(() => {
            if (isWatermarked && !img.matches(":hover")) {
              img.src = originalSrc;
              isWatermarked = false;
            }
          }, 3000);
        } catch (err) {
          console.error("Gagal menyiapkan watermark:", err);
        }
      });

      img.addEventListener("mouseleave", () => {
        if (isWatermarked) {
          img.src = originalSrc;
          isWatermarked = false;
        }
      });
    });
  }

  window.addEventListener("DOMContentLoaded", initGhostWatermark);
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initGhostWatermark();
  }
  document.addEventListener('astro:page-load', initGhostWatermark);
</script>
