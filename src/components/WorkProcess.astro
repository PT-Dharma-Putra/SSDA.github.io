---
import { useTranslations } from "../utils/i18n";

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang as any);

const steps = [
  {
    num: "01",
    label: t('process.step1'),
    icon: "forum", // Material Icon name
    description: lang === 'en' ? "Initial discussion to understand your needs, style preferences, and project scope." : "Diskusi awal untuk memahami kebutuhan, preferensi gaya, dan cakupan proyek Anda.",
  },
  {
    num: "02",
    label: t('process.step2'),
    icon: "architecture",
    description: lang === 'en' ? "Creating detailed layouts and 3D visualizations to bring your concept to life." : "Membuat tata letak detail dan visualisasi 3D untuk mewujudkan konsep Anda.",
  },
  {
    num: "03",
    label: t('process.step3'),
    icon: "category",
    description: lang === 'en' ? "Hand-picking high-quality wood, finishes, and hardware that match your design." : "Memilih kayu, finishing, dan perangkat keras berkualitas tinggi yang sesuai dengan desain Anda.",
  },
  {
    num: "04",
    label: t('process.step4'),
    icon: "precision_manufacturing",
    description: lang === 'en' ? "Crafting your furniture with precision using advanced systems and skilled artisans." : "Mengerjakan furnitur Anda dengan presisi menggunakan sistem canggih dan pengrajin ahli.",
  },
  {
    num: "05",
    label: t('process.step5'),
    icon: "build",
    description: lang === 'en' ? "Final assembly and thorough quality control to ensure every detail is perfect." : "Perakitan akhir dan kontrol kualitas menyeluruh untuk memastikan setiap detail sempurna.",
  },
  {
    num: "06",
    label: t('process.step6'),
    icon: "local_shipping",
    description: lang === 'en' ? "Safe transportation and professional installation at your site." : "Transportasi yang aman dan instalasi profesional di lokasi Anda.",
  },
];
---

<section id="process" class="relative py-24 md:py-32 overflow-hidden bg-[#f5f0ec]">
  <!-- Decorative Elements -->
  <div class="absolute top-0 left-0 w-1/2 h-full bg-navy/5 -skew-x-12 transform -translate-x-1/2 pointer-events-none"></div>
  
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-20" data-aos-wp="fade-up">
      <h2 class="font-display text-primary text-[10px] md:text-xs font-bold uppercase tracking-[0.4em] mb-4">
        {t('process.subtitle')}
      </h2>
      <p class="font-serif text-3xl md:text-5xl text-navy leading-tight" set:html={t('process.title')}>
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="relative">
      <!-- Central Line (Desktop) -->
      <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-primary/30 via-navy/20 to-transparent transform -translate-x-1/2"></div>

      <div class="space-y-12 md:space-y-0">
        {steps.map((step, index) => (
          <div 
            class={`relative flex flex-col md:flex-row items-center justify-between md:mb-24 last:mb-0 group`}
            data-aos-wp={index % 2 === 0 ? "fade-right" : "fade-left"}
          >
            <!-- Timeline Dot (Desktop) -->
            <div class="hidden md:flex absolute left-1/2 top-10 w-4 h-4 rounded-full bg-white border-4 border-primary transform -translate-x-1/2 z-20 group-hover:scale-125 transition-transform duration-300"></div>

            <!-- Content Side -->
            <div class={`w-full md:w-[45%] ${index % 2 === 0 ? 'md:text-right md:order-1' : 'md:text-left md:order-2'}`}>
              <div class={`glass-card p-8 rounded-2xl shadow-xl border border-white/50 hover-lift relative overflow-hidden group-hover:border-primary/30 transition-colors duration-500`}>
                <!-- Step Number Background -->
                <span class="absolute -top-4 -right-4 text-8xl font-bold text-navy/5 pointer-events-none">{step.num}</span>
                
                <div class={`flex items-center gap-4 mb-4 ${index % 2 === 0 ? 'md:flex-row-reverse' : 'md:flex-row'}`}>
                  <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all duration-500 shadow-sm">
                    <span class="material-icons-outlined text-2xl">{step.icon}</span>
                  </div>
                  <h3 class="font-serif text-xl md:text-2xl text-navy font-semibold">
                    {step.label}
                  </h3>
                </div>
                
                <p class="text-navy/70 text-sm md:text-base leading-relaxed font-light">
                  {step.description}
                </p>
              </div>
            </div>

            <!-- Empty Side (Desktop) -->
            <div class="hidden md:block md:w-[45%] md:order-1"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Custom glass effect adjustment if needed */
  .glass-card {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
</style>

<script>
  function initWPAnimations() {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-in');
          // observer.unobserve(entry.target); // Keep observing for re-entry if desired, or unobserve for performance
        }
      });
    }, observerOptions);

    const elements = document.querySelectorAll('[data-aos-wp]');
    elements.forEach(el => observer.observe(el));
  }

  // Inject animation styles
  if (!document.getElementById('wp-animations')) {
    const style = document.createElement('style');
    style.id = 'wp-animations';
    style.textContent = `
      [data-aos-wp] {
        opacity: 0;
        transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1);
      }
      [data-aos-wp="fade-up"] { transform: translateY(50px); }
      [data-aos-wp="fade-right"] { transform: translateX(-60px); }
      [data-aos-wp="fade-left"] { transform: translateX(60px); }
      
      .animate-in {
        opacity: 1 !important;
        transform: translate(0) !important;
      }
    `;
    document.head.appendChild(style);
  }

  // Initialize on load and on view transition
  document.addEventListener('DOMContentLoaded', initWPAnimations);
  document.addEventListener('astro:page-load', initWPAnimations);
</script>
