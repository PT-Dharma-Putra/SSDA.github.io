---
import { useTranslations } from "../utils/i18n";

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang as any);
---

<section class="relative py-24 bg-[#f5f0ec] overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 relative z-10 w-full">
    <div class="flex flex-col md:flex-row items-center justify-between gap-10 bg-navy rounded-[2rem] p-8 lg:p-16 shadow-[0_24px_48px_-12px_rgba(19,32,69,0.3)] relative overflow-hidden group">
      <!-- Decorative Background Elements for the Card -->
      <div class="absolute top-0 right-0 w-1/2 h-full bg-primary/10 -skew-x-12 transform translate-x-1/2 pointer-events-none group-hover:bg-primary/20 transition-all duration-700"></div>
      <div class="absolute bottom-0 left-0 w-1/3 h-full bg-white/5 blur-3xl pointer-events-none"></div>

      <!-- Left Content -->
      <div class="text-left space-y-6 max-w-2xl relative z-10">
        <div class="inline-flex items-center gap-3 px-4 py-1.5 rounded-full bg-white/10 border border-white/10">
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
          <span class="text-[10px] font-bold tracking-[0.2em] text-white/80 uppercase">{t('contact.free')}</span>
        </div>
        
        <h2 class="font-serif text-3xl md:text-4xl lg:text-5xl text-white font-bold leading-tight" set:html={t('contact.cta')} />
        
        <p class="text-white/60 text-base md:text-lg font-light leading-relaxed max-w-xl">
          {t('contact.desc')}
        </p>
      </div>

      <!-- Right Content (Button & Trust indicators) -->
      <div class="flex-shrink-0 w-full md:w-auto flex flex-col items-center md:items-end gap-8 relative z-10">
        <a
          href="https://wa.me/6281128507788"
          target="_blank"
          class="group relative inline-flex items-center justify-center gap-4 px-12 py-5 bg-primary text-white font-semibold rounded-2xl overflow-hidden shadow-xl shadow-primary/20 hover:shadow-primary/40 transition-all duration-300 w-full md:w-auto hover:-translate-y-1 active:scale-95"
        >
          <span class="absolute inset-0 bg-gradient-to-r from-white/0 via-white/20 to-white/0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out"></span>
          
          <span class="relative z-10 font-display text-sm md:text-base tracking-widest uppercase">{t('contact.btn')}</span>
          <span class="material-icons-outlined relative z-10 group-hover:translate-x-1 transition-transform">arrow_forward</span>
        </a>

        <!-- Trust Indicators -->
        <div class="flex flex-col items-center md:items-end gap-3">
          <div class="flex -space-x-3">
            {[1,2,3,4].map((i) => (
              <div class="w-10 h-10 rounded-full border-4 border-navy bg-navy/50 overflow-hidden">
                <img src={`/images/project/P${i}/1.jpg`} alt="" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" onerror="this.style.display='none'"/>
              </div>
            ))}
          </div>
          <span class="text-white/40 text-[10px] font-bold uppercase tracking-[0.2em]">
            {t('contact.trusted')}
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
