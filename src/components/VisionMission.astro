---
import { useTranslations } from "../utils/i18n";

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang as any);
---

<section id="vision-mission" class="relative py-24 md:py-32 overflow-hidden bg-background-light">
  <!-- Decorative Background Elements -->
  <div class="absolute top-0 right-0 w-1/3 h-full bg-navy/5 -skew-x-12 transform translate-x-1/2 pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-64 h-64 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-20" data-aos-vm="fade-up">
      <h2 class="font-display text-primary text-[10px] md:text-xs font-bold uppercase tracking-[0.4em] mb-4">
        {t('vm.title')}
      </h2>
      <p class="font-serif text-3xl md:text-5xl text-navy leading-tight" set:html={t('vm.main_title')} />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
      <!-- Image Side (Staggered) -->
      <div class="relative order-2 lg:order-1" data-aos-vm="fade-right">
        <div class="relative aspect-[4/5] md:aspect-video lg:aspect-[4/5] overflow-hidden rounded-2xl shadow-2xl">
          <img
            src="/images/2.png"
            alt="Interior Excellence"
            class="w-full h-full object-cover transition-transform duration-1000 hover:scale-110"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-navy/60 to-transparent opacity-60"></div>
        </div>
        
        <!-- Floating Accent -->
        <div class="absolute -bottom-6 -right-6 md:-bottom-10 md:-right-10 w-32 h-32 md:w-48 md:h-48 bg-primary/10 border border-primary/20 backdrop-blur-xl rounded-2xl -z-10 animate-pulse"></div>
      </div>

      <!-- Content Side -->
      <div class="space-y-8 order-1 lg:order-2">
        <!-- Mission Card -->
        <div 
          class="glass-card p-8 md:p-10 rounded-2xl shadow-xl border border-white/50 hover-lift group"
          data-aos-vm="fade-left"
          data-aos-delay="100"
        >
          <div class="flex items-start gap-6">
            <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all duration-500">
              <span class="material-icons-outlined text-3xl">auto_awesome</span>
            </div>
            <div class="flex-1">
              <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary/60 mb-2 block">
                {t('vm.mission_subtitle')}
              </span>
              <h3 class="font-serif text-2xl md:text-3xl text-navy mb-4">
                {t('vm.mission')}
              </h3>
              <p class="text-navy/70 text-sm md:text-base leading-relaxed font-light">
                {t('vm.mission_text')}
              </p>
            </div>
          </div>
        </div>

        <!-- Vision Card -->
        <div 
          class="glass-card p-8 md:p-10 rounded-2xl shadow-xl border border-white/50 hover-lift group lg:translate-x-12"
          data-aos-vm="fade-left"
          data-aos-delay="300"
        >
          <div class="flex items-start gap-6">
            <div class="w-14 h-14 rounded-xl bg-navy/5 flex items-center justify-center text-navy group-hover:bg-navy group-hover:text-white transition-all duration-500">
              <span class="material-icons-outlined text-3xl">visibility</span>
            </div>
            <div class="flex-1">
              <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-navy/40 mb-2 block">
                {t('vm.vision_subtitle')}
              </span>
              <h3 class="font-serif text-2xl md:text-3xl text-navy mb-4">
                {t('vm.vision')}
              </h3>
              <p class="text-navy/70 text-sm md:text-base leading-relaxed font-light">
                {t('vm.vision_text')}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initVMAnimations() {
    const observerOptions = {
      threshold: 0.15,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-in');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const elements = document.querySelectorAll('[data-aos-vm]');
    elements.forEach(el => observer.observe(el));
  }

  // Inject animation styles
  if (!document.getElementById('vm-animations')) {
    const style = document.createElement('style');
    style.id = 'vm-animations';
    style.textContent = `
      [data-aos-vm] {
        opacity: 0;
        transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
      }
      [data-aos-vm="fade-up"] { transform: translateY(40px); }
      [data-aos-vm="fade-right"] { transform: translateX(-40px); }
      [data-aos-vm="fade-left"] { transform: translateX(40px); }
      
      .animate-in {
        opacity: 1 !important;
        transform: translate(0) !important;
      }
      
      [data-aos-delay="100"] { transition-delay: 0.1s; }
      [data-aos-delay="300"] { transition-delay: 0.3s; }
    `;
    document.head.appendChild(style);
  }

  document.addEventListener('DOMContentLoaded', initVMAnimations);
  document.addEventListener('astro:page-load', initVMAnimations);
</script>
