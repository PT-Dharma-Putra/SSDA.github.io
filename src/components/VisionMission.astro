---
import { useTranslations } from "../utils/i18n";

const lang = Astro.currentLocale || "en";
const t = useTranslations(lang as any);
---

<section
  id="vision-mission"
  class="relative py-12 lg:py-16 lg:min-h-screen flex items-center overflow-hidden bg-background-light"
>
  <!-- Decorative Background Elements (Aesthetic Ambient Glows) -->
  <div
    class="absolute top-0 right-0 w-1/3 h-full bg-navy/5 -skew-x-12 transform translate-x-1/2 pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-0 left-10 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none"
  >
  </div>
  <div
    class="absolute top-10 right-10 w-96 h-96 bg-navy/5 rounded-full blur-3xl pointer-events-none"
  >
  </div>

  <div class="max-w-6xl mx-auto px-6 relative z-10 w-full flex flex-col justify-center h-full">
    <!-- Section Header -->
    <div class="text-left mb-6 lg:mb-8" data-aos-vm="fade-right">
      <span
        class="font-display text-primary text-[10px] md:text-xs font-bold uppercase tracking-[0.4em] mb-2 block"
      >
        {t("vm.title")}
      </span>
      <h2
        class="font-serif text-xl sm:text-2xl md:text-4xl lg:text-5xl text-navy leading-tight"
        set:html={t("vm.main_title")}
      />
    </div>

    <!-- Content & Video Grid -->
    <div class="grid grid-cols-[1.1fr_0.9fr] sm:grid-cols-[1fr_1fr] lg:grid-cols-2 gap-4 sm:gap-6 lg:gap-12 items-center">
      <!-- Left Column: Cards Container -->
      <div class="space-y-3 lg:space-y-6 flex flex-col justify-center flex-1 w-full" data-aos-vm="fade-right">
        <!-- Mission Card -->
        <div
          class="glass-card p-3 sm:p-4 lg:p-6 rounded-2xl shadow-xl border border-white/50 hover-lift group flex-1 flex flex-col justify-start relative overflow-hidden transition-all duration-500 hover:border-primary/20"
          data-aos-delay="100"
        >
          <div class="flex items-start gap-2.5 lg:gap-6">
            <div
              class="w-7 h-7 sm:w-10 sm:h-10 lg:w-12 lg:h-12 rounded-lg lg:rounded-xl bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white group-hover:rotate-6 group-hover:scale-115 transition-all duration-500 flex-shrink-0"
            >
              <span class="material-icons-outlined text-sm sm:text-lg lg:text-2xl transition-transform duration-500">auto_awesome</span>
            </div>
            <div class="flex-1 min-w-0">
              <span
                class="text-[7px] sm:text-[9px] md:text-[10px] font-bold uppercase tracking-[0.2em] text-primary/60 mb-0.5 lg:mb-1 block"
              >
                {t("vm.mission_subtitle")}
              </span>
              <h3 class="font-serif text-xs sm:text-base md:text-xl lg:text-2xl text-navy mb-0.5 lg:mb-2">
                {t("vm.mission")}
              </h3>
              <div
                class="vm-text-scroll text-navy/70 text-[9px] sm:text-xs lg:text-base leading-relaxed font-light overflow-y-auto max-h-[120px] sm:max-h-[160px] lg:max-h-[240px] xl:max-h-[280px] pr-2 custom-scrollbar transition-all duration-300"
                set:html={t("vm.mission_text")}
              />
            </div>
          </div>
        </div>

        <!-- Vision Card -->
        <div
          class="glass-card p-3 sm:p-4 lg:p-6 rounded-2xl shadow-xl border border-white/50 hover-lift group lg:translate-x-4 flex-1 flex flex-col justify-start relative overflow-hidden transition-all duration-500 hover:border-navy/20"
          data-aos-delay="300"
        >
          <div class="flex items-start gap-2.5 lg:gap-6">
            <div
              class="w-7 h-7 sm:w-10 sm:h-10 lg:w-12 lg:h-12 rounded-lg lg:rounded-xl bg-navy/5 flex items-center justify-center text-navy group-hover:bg-navy group-hover:text-white group-hover:-rotate-6 group-hover:scale-115 transition-all duration-500 flex-shrink-0"
            >
              <span class="material-icons-outlined text-sm sm:text-lg lg:text-2xl transition-transform duration-500">visibility</span>
            </div>
            <div class="flex-1 min-w-0">
              <span
                class="text-[7px] sm:text-[9px] md:text-[10px] font-bold uppercase tracking-[0.2em] text-navy/40 mb-0.5 lg:mb-1 block"
              >
                {t("vm.vision_subtitle")}
              </span>
              <h3 class="font-serif text-xs sm:text-base md:text-xl lg:text-2xl text-navy mb-0.5 lg:mb-2">
                {t("vm.vision")}
              </h3>
              <div
                class="vm-text text-navy/70 text-[9px] sm:text-xs lg:text-base leading-relaxed font-light line-clamp-3 transition-all duration-300"
                set:html={t("vm.vision_text")}
              />
              <button
                class="vm-toggle-btn mt-1 text-[8px] sm:text-[10px] font-bold text-navy flex items-center gap-0.5 cursor-pointer hover:opacity-80 transition-opacity"
                data-text-more={t("vm.see_detail")}
                data-text-less={t("vm.show_less")}
              >
                <span class="btn-text">{t("vm.see_detail")}</span>
                <span class="material-icons-outlined text-[10px] sm:text-xs transition-transform duration-300 pointer-events-none">expand_more</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Video Side -->
      <div class="flex flex-col items-center justify-center w-full" data-aos-vm="fade-left">
        <div class="relative">
          <!-- Double Blueprint Frame Accents -->
          <div
            class="absolute -bottom-3 -left-3 lg:-bottom-5 lg:-left-5 w-16 h-16 lg:w-32 lg:h-32 bg-primary/5 border border-primary/10 rounded-xl lg:rounded-2xl -z-10 animate-pulse"
          >
          </div>
          <div
            class="absolute -top-3 -right-3 lg:-top-5 lg:-right-5 w-16 h-16 lg:w-32 lg:h-32 bg-navy/5 border border-navy/10 rounded-xl lg:rounded-2xl -z-10"
          >
          </div>

          <!-- Video Container -->
          <div
            class="relative vm-video-wrapper overflow-hidden rounded-2xl lg:rounded-3xl shadow-2xl group/video border border-white/30 backdrop-blur-md"
          >
            <video
              id="vm-video"
              autoplay
              loop
              muted
              playsinline
              class="w-full h-full object-cover transition-transform duration-1000 hover:scale-103"
            >
              <source src="/images/video/3.mp4" type="video/mp4" />
              <source src="/images/video/3.MOV" type="video/quicktime" />
              <source src="/images/video/3.MOV" />
              Your browser does not support the video tag.
            </video>
            <div
              class="absolute inset-0 bg-gradient-to-t from-navy/30 via-transparent to-transparent opacity-60 pointer-events-none"
            >
            </div>

            <!-- Custom Glass Video Controls -->
            <div class="absolute bottom-2 left-2 right-2 sm:bottom-3 sm:left-3 sm:right-3 z-20 flex justify-between items-center">
              <!-- Play/Pause Button -->
              <button
                id="vm-play-btn"
                class="w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-navy/60 backdrop-blur-md border border-white/20 flex items-center justify-center text-white hover:bg-primary hover:scale-110 active:scale-95 transition-all duration-300 shadow-lg cursor-pointer"
                aria-label="Play or Pause video"
              >
                <span class="material-icons-outlined text-[10px] sm:text-sm">pause</span>
              </button>

              <!-- Mute/Unmute Button -->
              <button
                id="vm-mute-btn"
                class="w-6 h-6 sm:w-8 sm:h-8 rounded-full bg-navy/60 backdrop-blur-md border border-white/20 flex items-center justify-center text-white hover:bg-primary hover:scale-110 active:scale-95 transition-all duration-300 shadow-lg cursor-pointer"
                aria-label="Mute or Unmute video"
              >
                <span class="material-icons-outlined text-[10px] sm:text-sm">volume_off</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initVMAnimations() {
    const observerOptions = {
      threshold: 0.15,
      rootMargin: "0px 0px -50px 0px",
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("animate-in");
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const elements = document.querySelectorAll("[data-aos-vm]");
    elements.forEach((el) => observer.observe(el));
  }

  function initVideoControls() {
    const video = document.getElementById("vm-video") as HTMLVideoElement | null;
    const playBtn = document.getElementById("vm-play-btn");
    const muteBtn = document.getElementById("vm-mute-btn");

    if (!video || !playBtn || !muteBtn) return;

    const playIcon = playBtn.querySelector(".material-icons-outlined");
    const muteIcon = muteBtn.querySelector(".material-icons-outlined");

    // Click handler for Play/Pause
    playBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      if (video.paused) {
        video.play().catch((err) => console.log("Play interrupted: ", err));
        if (playIcon) playIcon.textContent = "pause";
      } else {
        video.pause();
        if (playIcon) playIcon.textContent = "play_arrow";
      }
    });

    // Click handler for Mute/Unmute
    muteBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      video.muted = !video.muted;
      if (muteIcon) {
        muteIcon.textContent = video.muted ? "volume_off" : "volume_up";
      }
    });

    // Sync icons in case browser autoplay or user agent changes state automatically
    video.addEventListener("play", () => {
      if (playIcon) playIcon.textContent = "pause";
    });
    video.addEventListener("pause", () => {
      if (playIcon) playIcon.textContent = "play_arrow";
    });
  }

  function initDetailToggles() {
    const toggleBtns = document.querySelectorAll(".vm-toggle-btn");
    toggleBtns.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const cardBody = btn.closest(".flex-1");
        if (!cardBody) return;
        const textEl = cardBody.querySelector(".vm-text");
        const iconEl = btn.querySelector(".material-icons-outlined");
        const btnTextEl = btn.querySelector(".btn-text");

        if (!textEl || !btnTextEl) return;

        const isExpanded = textEl.classList.contains("line-clamp-none");
        const textMore = btn.getAttribute("data-text-more") || "See Details";
        const textLess = btn.getAttribute("data-text-less") || "Show Less";

        if (isExpanded) {
          textEl.classList.remove("line-clamp-none");
          textEl.classList.add("line-clamp-3");
          btnTextEl.textContent = textMore;
          if (iconEl) iconEl.classList.remove("rotate-180");
        } else {
          textEl.classList.remove("line-clamp-3");
          textEl.classList.add("line-clamp-none");
          btnTextEl.textContent = textLess;
          if (iconEl) iconEl.classList.add("rotate-180");
        }
      });
    });
  }

  function initVM() {
    initVMAnimations();
    initVideoControls();
    initDetailToggles();
  }

  // Inject animation and custom layout styles
  if (!document.getElementById("vm-animations")) {
    const style = document.createElement("style");
    style.id = "vm-animations";
    style.textContent = `
      [data-aos-vm] {
        opacity: 0;
        transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
      }
      [data-aos-vm="fade-up"] { transform: translateY(40px); }
      [data-aos-vm="fade-right"] { transform: translateX(-40px); }
      [data-aos-vm="fade-left"] { transform: translateX(40px); }
      
      .animate-in {
        opacity: 1 !important;
        transform: translate(0) !important;
      }
      
      [data-aos-delay="100"] { transition-delay: 0.1s; }
      [data-aos-delay="300"] { transition-delay: 0.3s; }

      .vm-video-wrapper {
        height: 46vh;
        width: auto;
        aspect-ratio: 9/16;
        max-width: 100%;
      }
      @media (min-width: 640px) {
        .vm-video-wrapper {
          height: 62vh;
        }
      }
      @media (min-width: 1024px) {
        .vm-video-wrapper {
          height: 80vh;
        }
      }

      /* Custom styled scrollbar matching the image */
      .custom-scrollbar {
        scrollbar-width: thin;
        scrollbar-color: #888888 #e0e0e0;
      }
      .custom-scrollbar::-webkit-scrollbar {
        width: 10px;
      }
      .custom-scrollbar::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #888888;
        border-radius: 10px;
        border: 2px solid #f1f1f1;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #555555;
      }
    `;
    document.head.appendChild(style);
  }

  // Robust initialization that handles deferred execution
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initVM);
  } else {
    initVM();
  }
  document.addEventListener("astro:page-load", initVM);
</script>
