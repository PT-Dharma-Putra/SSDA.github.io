---
import { projectsData } from "../data/projects.js";
import { useTranslations } from "../utils/i18n";
import fs from "node:fs";
import path from "node:path";

const lang = Astro.currentLocale || 'en';
const t = useTranslations(lang as any);
const langPrefix = lang === 'en' ? '' : `/${lang}`;

// Resolve first image from each project folder
const projects = projectsData.map((project) => {
  let thumb = project.image;
  if (project.folderName) {
    try {
      const dir = path.join(process.cwd(), "public", "images", "project", project.folderName);
      if (fs.existsSync(dir)) {
        const imgs = fs.readdirSync(dir).filter((f) =>
          [".jpg", ".jpeg", ".png", ".webp"].includes(path.extname(f).toLowerCase())
        );
        if (imgs.length) thumb = `/images/project/${project.folderName}/${imgs[0]}`;
      }
    } catch {}
  }
  return { ...project, thumb };
});
---

<section id="project-showcase" class="ps-section">
  <div class="ps-container">
    <!-- ── Header & Navigation ── -->
    <div class="ps-top-bar">
      <div class="ps-header">
        <span class="ps-eyebrow">{t('projects.portfolio')}</span>
        <h2 class="ps-title">{t('projects.title')}</h2>
        <p class="ps-subtitle">
          {t('projects.subtitle')}
        </p>
      </div>

      <!-- Navigation buttons moved to top right -->
      <div class="ps-controls">
        <button class="ps-nav-btn" id="ps-prev-btn" aria-label="Previous projects">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
          </svg>
        </button>
        <button class="ps-nav-btn" id="ps-next-btn" aria-label="Next projects">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- ── Carousel ── -->
    <div class="ps-carousel-wrapper">
      <div class="ps-carousel" id="ps-carousel">
        {projects.map((project) => (
          <a href={`${langPrefix}/projects/${project.slug}`} class="ps-card group">
            <div class="ps-card-img-wrap">
              <img
                class="ps-card-img"
                src={project.thumb}
                alt={project.title}
                loading="lazy"
                onerror="this.src='/images/hero-bg.png'"
              />
              <div class="ps-card-overlay"></div>
            </div>
            
            <div class="ps-card-content">
              <div class="ps-card-meta">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-pin">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>{project.details.location}</span>
                <span class="mx-2">•</span>
                <span>{project.category[lang as keyof typeof project.category] || project.category.en}</span>
              </div>
              
              <h3 class="ps-card-name">{project.title}</h3>
              
              <div class="ps-card-footer">
                <span class="ps-btn-text">{t('projects.viewDetail')}</span>
                <span class="ps-btn-arrow">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14"></path>
                    <path d="m12 5 7 7-7 7"></path>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .ps-section {
    background-color: #f5f0ec;
    padding: 96px 24px;
    overflow: hidden;
  }

  .ps-container {
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
  }

  /* ─── Top Bar (Header + Controls) ─── */
  .ps-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
    gap: 24px;
  }

  .ps-header {
    max-width: 640px;
  }

  .ps-eyebrow {
    display: block;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #e4222e; /* Brand accent red */
    margin-bottom: 12px;
  }

  .ps-title {
    font-family: 'Plus Jakarta Sans', serif;
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 700;
    color: #132045; /* Brand navy */
    margin: 0 0 16px;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .ps-subtitle {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.05rem;
    line-height: 1.7;
    color: #52525b;
    margin: 0;
  }

  /* ─── Controls ─── */
  .ps-controls {
    display: flex;
    gap: 12px;
    flex-shrink: 0;
  }

  .ps-nav-btn {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid rgba(19, 32, 69, 0.15);
    background: transparent;
    color: #132045;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ps-nav-btn svg {
    width: 24px;
    height: 24px;
    transition: transform 0.3s ease;
  }

  .ps-nav-btn:hover {
    background-color: #132045;
    color: #ffffff;
    border-color: #132045;
  }

  .ps-nav-btn:active {
    transform: scale(0.95);
  }

  /* ─── Carousel ─── */
  .ps-carousel-wrapper {
    margin-right: -24px; /* bleed right edge on mobile */
  }

  .ps-carousel {
    display: flex;
    gap: 32px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-bottom: 40px; /* space for shadows */
    margin-left: -12px;
    padding-left: 12px;
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }

  .ps-carousel::-webkit-scrollbar {
    display: none;
  }

  /* ─── Cards ─── */
  .ps-card {
    display: flex;
    flex-direction: column;
    min-width: 360px;
    max-width: 360px;
    flex: 0 0 auto;
    scroll-snap-align: start;
    background-color: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid rgba(0,0,0,0.02);
    height: max-content; /* Make card fit content to remove unnecessary gaps */
  }

  .ps-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(19, 32, 69, 0.08);
  }

  /* ─── Card Image ─── */
  .ps-card-img-wrap {
    position: relative;
    width: 100%;
    height: 220px; /* Reduced image height slightly */
    overflow: hidden;
  }

  .ps-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .ps-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(19,32,69,0.1) 0%, transparent 50%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .ps-card:hover .ps-card-img {
    transform: scale(1.08);
  }

  .ps-card:hover .ps-card-overlay {
    opacity: 1;
  }

  /* ─── Card Content ─── */
  .ps-card-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
  }

  .ps-card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #71717a;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .icon-pin {
    width: 16px;
    height: 16px;
    color: #e4222e; /* Map pin in accent red */
  }

  .ps-card-name {
    font-family: 'Plus Jakarta Sans', serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #132045;
    margin: 0 0 16px;
    line-height: 1.25;
    transition: color 0.3s ease;
  }

  /* ─── Card Footer / Action ─── */
  .ps-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #f4f4f5;
    padding-top: 16px;
  }

  .ps-btn-text {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: #132045;
    position: relative;
    overflow: hidden;
  }

  .ps-btn-text::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1.5px;
    background-color: #132045;
    transform: translateX(-100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ps-card:hover .ps-btn-text::after {
    transform: translateX(0);
  }

  .ps-btn-arrow {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #f4f4f5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #132045;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ps-btn-arrow svg {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
  }

  .ps-card:hover .ps-btn-arrow {
    background-color: #132045;
    color: #ffffff;
  }

  .ps-card:hover .ps-btn-arrow svg {
    transform: translateX(2px);
  }

  /* ─── Responsive ─── */
  @media (max-width: 1024px) {
    .ps-top-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
    }
    .ps-controls {
      align-self: flex-end;
    }
  }

  @media (max-width: 768px) {
    .ps-section {
      padding: 64px 20px;
    }
    .ps-card {
      min-width: 300px;
      max-width: 300px;
    }
    .ps-card-img-wrap {
      height: 200px;
    }
    .ps-card-name {
      font-size: 1.4rem;
    }
    .ps-card-content {
      padding: 24px 20px;
    }
  }
</style>

<script>
  function initProjectCarousel() {
    const carousel = document.getElementById('ps-carousel');
    const nextBtn = document.getElementById('ps-next-btn');
    const prevBtn = document.getElementById('ps-prev-btn');

    if (carousel && nextBtn && prevBtn) {
      // Calculate scroll amount based on card width + gap
      const getScrollAmount = () => {
        const card = carousel.querySelector('.ps-card');
        if (card) {
          const cardWidth = card.getBoundingClientRect().width;
          const gap = 32; // Defined in CSS gap: 32px
          return cardWidth + gap;
        }
        return 392; // Fallback
      };

      nextBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
      });

      prevBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
      });
      
      // Optional: Add drag to scroll functionality
      let isDown = false;
      let startX: number;
      let scrollLeft: number;

      carousel.addEventListener('mousedown', (e) => {
        isDown = true;
        carousel.classList.add('active');
        startX = e.pageX - carousel.offsetLeft;
        scrollLeft = carousel.scrollLeft;
        // Prevent link click when dragging
        carousel.style.cursor = 'grabbing';
      });

      carousel.addEventListener('mouseleave', () => {
        isDown = false;
        carousel.classList.remove('active');
        carousel.style.cursor = '';
      });

      carousel.addEventListener('mouseup', () => {
        isDown = false;
        carousel.classList.remove('active');
        carousel.style.cursor = '';
      });

      carousel.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - carousel.offsetLeft;
        const walk = (x - startX) * 2; // Scroll speed multiplier
        carousel.scrollLeft = scrollLeft - walk;
      });
    }
  }

  document.addEventListener("DOMContentLoaded", initProjectCarousel);
  document.addEventListener("astro:page-load", initProjectCarousel);
</script>
